# Copy this file to ".env" and fill in your real values.
# Do NOT commit the real .env file to git.

# --- Required ---

# Your Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Your numeric Telegram user/chat ID (the owner who is allowed to control the bot)
OWNER_CHAT_ID=000000000

# Your Telegram username (without @) — used as a secondary auth check
OWNER_USERNAME=your_telegram_username

# --- Optional ---

# Additional authorized chat IDs (comma-separated)
# EXTRA_OWNER_CHAT_IDS=1111,2222

# Additional authorized usernames (comma-separated, no @)
# EXTRA_OWNER_USERNAMES=alice,bob

# Per-chat rate limit (messages per minute). Default 60.
# RATE_LIMIT_PER_MINUTE=60

# Default screen-recording duration in seconds. Default 30.
# SCREEN_RECORD_SECONDS=30

# DEBUG, INFO, WARNING, ERROR. Default INFO.
# LOG_LEVEL=INFO
